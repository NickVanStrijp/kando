{
  "name": "kando",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @kando/desktop",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "start": "npm run start -w @kando/desktop",
    "package": "npm run package -w @kando/desktop",
    "make": "npm run make -w @kando/desktop"
  }
}